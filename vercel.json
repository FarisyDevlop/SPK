{
  "outputDirectory": "public",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.8.0"
    }
  },
  "routes": [
    {
      "src": "/vendor/(.*)",
      "dest": "/vendor/$1"
    },
    {
      "src": "/(favicon\\.ico|robots\\.txt)",
      "dest": "/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_NAME": "SPK SAW Vendor SIMRS",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_LOCALE": "id",
    "DB_CONNECTION": "pgsql",
    "SESSION_DRIVER": "database",
    "CACHE_STORE": "database",
    "LOG_CHANNEL": "stderr",
    "VIEW_COMPILED_PATH": "/tmp/views",
    "APP_CONFIG_CACHE": "/tmp/config.php",
    "APP_EVENTS_CACHE": "/tmp/events.php",
    "APP_PACKAGES_CACHE": "/tmp/packages.php",
    "APP_ROUTES_CACHE": "/tmp/routes.php",
    "APP_SERVICES_CACHE": "/tmp/services.php"
  },
  "build": {
    "env": {
      "APP_ENV": "production",
      "DB_CONNECTION": "pgsql",
      "LOG_CHANNEL": "stderr",
      "CACHE_STORE": "array"
    }
  }
}
